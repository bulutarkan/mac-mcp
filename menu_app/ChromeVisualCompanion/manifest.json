{
  "manifest_version": 3,
  "name": "Mac MCP Chrome Companion",
  "version": "2.1.2",
  "description": "Chrome-only Mac MCP visual companion and non-focus-stealing background tab transport.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "visual.js",
        "bridge_wake.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "permissions": [
    "debugger"
  ]
}
