# Mac MCP Server - Environment Config
# Copy this file to mcp_server/.env and adjust it before exposing the server.

# Bearer token for API authentication.
# Recommended: set this to a long random string and set MCP_ALLOW_NO_AUTH=false.
MCP_API_KEY=change-me-please
MCP_ALLOW_NO_AUTH=false

# Allow shell commands. Disable this if you only want non-shell tools.
MCP_ALLOW_SHELL=true

# Optional default workspace.
# By default, Mac MCP uses your macOS home directory, e.g. /Users/yourname.
# Set this if you want file/search tools to resolve relative paths from another folder.
# Example:
# MAC_MCP_HOME=~/Projects
# WORKDIR=~/Projects

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Command timeouts (seconds)
DEFAULT_COMMAND_TIMEOUT_S=120
MAX_COMMAND_TIMEOUT_S=600

# Max output characters
MAX_OUTPUT_CHARS=100000

# Local operations dashboard telemetry
# Dashboard UI is always localhost-only, even when /mcp is exposed through a tunnel.
# MAC_MCP_TELEMETRY_DIR=~/.mac-mcp/dashboard
# MAC_MCP_TELEMETRY_RETENTION_DAYS=7
# MAC_MCP_TELEMETRY_MAX_EVENTS=20000
# MAC_MCP_TELEMETRY_PREVIEW_CHARS=4000

# HTTP tool settings
HTTP_ALLOWLIST=*
HTTP_HTTPS_ONLY=false
HTTP_MAX_RESPONSE_BYTES=5000000
HTTP_TIMEOUT_S=60


# ngrok tunnel settings for Custom GPT Actions.
# Create a static domain in ngrok, then paste only the domain here.
# Example: NGROK_DOMAIN=your-domain.ngrok-free.dev
NGROK_DOMAIN=your-domain.ngrok-free.dev
# NGROK_BIN=ngrok

# Voice interaction (ask_user_voice)
# High-quality Turkish TTS uses edge-tts (no API key). STT uses Groq Whisper.
# Prefer the native menu bar app, which stores the Groq key in macOS Keychain.
# Environment and legacy UserDefaults sources remain supported fallbacks.
# MAC_MCP_VOICE_GROQ_API_KEY=
# MAC_MCP_VOICE_GROQ_KEYCHAIN_SERVICE=com.bulutarkan.mac-mcp
# MAC_MCP_VOICE_GROQ_KEYCHAIN_ACCOUNT=groq-api-key
# MAC_MCP_VOICE_GROQ_DEFAULTS_DOMAIN=com.example.yourapp
# MAC_MCP_VOICE_GROQ_DEFAULTS_KEY=groqAPIKey
# MAC_MCP_VOICE_LANGUAGE=auto
# MAC_MCP_VOICE_INPUT_DEVICE=auto
# MAC_MCP_VOICE_OUTPUT_DEVICE=system
# MAC_MCP_VOICE_TTS_RATE=-5%

# Browser tool settings
BROWSER_ALLOWLIST=*
BROWSER_HTTPS_ONLY=false
DOWNLOAD_DIR=~/Downloads
MAX_JS_RESULT_CHARS=20000
MAX_HTML_CHARS=200000
MAX_WAIT_S=120

# Persistent memory and Agent Skills
# MAC_MCP_MEMORY_DIR=~/.mac-mcp/memory
# MAC_MCP_SKILLS_DIR=~/.mac-mcp/skills
# memory_search and skill_search share one on-demand FastEmbed worker/cache/model.
# MAC_MCP_EMBEDDING_MODEL_CACHE=~/.mac-mcp/cache/fastembed
# MAC_MCP_EMBEDDING_IDLE_SECONDS=60
# MAC_MCP_EMBEDDING=auto
# Legacy MAC_MCP_MEMORY_MODEL_CACHE / _MODEL_IDLE_SECONDS / _EMBEDDING remain supported.
